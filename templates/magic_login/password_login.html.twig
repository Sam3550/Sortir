{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="min-h-[80vh] flex flex-col justify-center items-center">
        <div class="card w-full max-w-md mx-auto fade-in shadow-2xl border-0">
             <div class="p-8">
                <div class="flex justify-center mb-6">
                    <div class="p-3 bg-green-100 rounded-full">
                         <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    </div>
                </div>

                <h2 class="text-2xl font-bold text-center text-gray-900 mb-2">Bon retour !</h2>
                <div class="text-center mb-8">
                    <div class="inline-flex items-center px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-sm font-medium">
                        {{ email }}
                    </div>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                
                <div>
                     {{ form_label(form.password, 'Mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    <div class="relative">
                         <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        </div>
                        {{ form_widget(form.password, {'attr': {'class': '!pl-14 form-input w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3', 'placeholder': '••••••••'}}) }}
                    </div>
                    {{ form_errors(form.password) }}
                </div>
                
                {# Le champ caché #}
                {{ form_widget(form.email) }}

                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200">
                    Se connecter
                </button>

                <div class="text-center mt-4">
                    <a href="{{ path('app_magic_login') }}" class="text-sm text-gray-500 hover:text-indigo-600">
                        Ce n'est pas vous ? Changer d'email
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
