{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="min-h-[80vh] flex flex-col justify-center items-center">
        <div class="text-center mb-10">
            <h1 class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600 mb-4 inline-block tracking-tight">Sortir.com</h1>
            <p class="text-xl text-gray-500 max-w-md mx-auto">Rejoignez vos collègues pour des événements inoubliables.</p>
        </div>

        <div class="card w-full max-w-md mx-auto fade-in shadow-2xl border-0">
             <div class="p-8">
                <div class="flex justify-center mb-6">
                    <div class="p-3 bg-indigo-100 rounded-full">
                        <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
                    </div>
                </div>

                <h2 class="text-2xl font-bold text-center text-gray-900 mb-8">Connexion / Inscription</h2>

                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                
                <div>
                    {{ form_label(form.email, 'Adresse E-mail', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        {{ form_widget(form.email, {'attr': {'class': '!pl-14 form-input w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3', 'placeholder': 'exemple@campus-eni.fr'}}) }}
                    </div>
                    {{ form_errors(form.email) }}
                </div>

                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200">
                    Continuer
                    <svg class="ml-2 -mr-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
                </button>

                {{ form_end(form) }}
            </div>
            <div class="px-8 py-4 bg-gray-50 border-t border-gray-100 rounded-b-xl text-center">
                <p class="text-xs text-gray-500">
                    Saisissez votre email. Si vous avez un compte, vous entrerez votre mot de passe. Sinon, un administrateur doit vous avoir invité.
                </p>
            </div>
        </div>
    </div>
{% endblock %}
