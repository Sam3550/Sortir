{% extends 'base.html.twig' %}

{% block title %}Liste des sorties{% endblock %}

{% block body %}
    <div class="mb-10 text-center">
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl mb-3 flex items-center justify-center gap-3">
            Découvrez les <span class="page-title-gradient">sorties à venir</span> 🎉
        </h1>
        <p class="max-w-2xl mx-auto text-lg text-gray-500">
            Rejoignez d'autres étudiants, participez à des activités et partagez de bons moments.
        </p>
    </div>
    
    {{ form_start(formSearchFilter) }}
    
    {# Carte de filtres #}
    <div class="card fade-in" id="filters-card">
        <div class="card-header cursor-pointer select-none" onclick="toggleFilters()">
            <div class="icon">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                </svg>
            </div>
            <h2>Filtres de recherche</h2>
            <div class="ml-auto transition-transform duration-300" id="filters-chevron">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </div>
        </div>
        
        <div id="filters-content" class="md:block transition-all duration-300 overflow-hidden" style="max-height: 0; opacity: 0;">
            <div class="p-6 pt-0 border-t border-gray-100">
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 pt-6">
                    {# Colonne 1 : Campus et Recherche #}
                    <div class="space-y-4">
                        <div class="form-group mb-0">
                            {{ form_label(formSearchFilter.campus, "Campus", {'label_attr': {'class': 'block text-xs uppercase tracking-wide text-gray-500 font-bold mb-2'}}) }}
                            {{ form_widget(formSearchFilter.campus, {'attr': {'class': 'form-select w-full'}}) }}
                        </div>
                        <div class="form-group mb-0">
                            {{ form_label(formSearchFilter.sortieNom, "Nom de la sortie", {'label_attr': {'class': 'block text-xs uppercase tracking-wide text-gray-500 font-bold mb-2'}}) }}
                            {{ form_widget(formSearchFilter.sortieNom, {'attr': {'class': 'form-input w-full', 'placeholder': 'Rechercher...'}}) }}
                        </div>
                    </div>

                    {# Colonne 2 : Dates #}
                    <div class="space-y-4">
                        <div class="form-group mb-0">
                           {{ form_label(formSearchFilter.premiereDate, "Date de début", {'label_attr': {'class': 'block text-xs uppercase tracking-wide text-gray-500 font-bold mb-2'}}) }}
                           {{ form_widget(formSearchFilter.premiereDate, {'attr': {'class': 'form-input w-full'}}) }}
                        </div>
                        <div class="form-group mb-0">
                           {{ form_label(formSearchFilter.derniereDate, "Date de fin", {'label_attr': {'class': 'block text-xs uppercase tracking-wide text-gray-500 font-bold mb-2'}}) }}
                           {{ form_widget(formSearchFilter.derniereDate, {'attr': {'class': 'form-input w-full'}}) }}
                        </div>
                    </div>
                
                    {# Colonne 3 : Checkboxes (Grid 2x2) #}
                    <div>
                         <span class="block text-xs uppercase tracking-wide text-gray-500 font-bold mb-2">Options</span>
                         <div class="grid grid-cols-1 gap-2 bg-gray-50 p-3 rounded-lg border border-gray-100 h-full">
                            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-1.5 rounded transition">
                                {{ form_widget(formSearchFilter.sortiesOrganisees, {'attr': {'class': 'form-checkbox h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500'}}) }}
                                <span class="text-xs font-medium text-gray-700">Je suis l'organisateur</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-1.5 rounded transition">
                                {{ form_widget(formSearchFilter.sortiesInscrites, {'attr': {'class': 'form-checkbox h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500'}}) }}
                                <span class="text-xs font-medium text-gray-700">Je suis inscrit</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-1.5 rounded transition">
                                {{ form_widget(formSearchFilter.sortiesNonInscrites, {'attr': {'class': 'form-checkbox h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500'}}) }}
                                <span class="text-xs font-medium text-gray-700">Je ne suis pas inscrit</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-1.5 rounded transition">
                                {{ form_widget(formSearchFilter.sortiesPassees, {'attr': {'class': 'form-checkbox h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500'}}) }}
                                <span class="text-xs font-medium text-gray-700">Sorties passées</span>
                            </label>
                        </div>
                    </div>
                
                    {# Colonne 4 : Boutons #}
                    <div class="flex flex-col justify-center h-full gap-3">
                        {{ form_widget(formSearchFilter.rechercher, {'attr': {'class': 'btn btn-primary w-full justify-center'}}) }}
                        {{ form_widget(formSearchFilter.reinitialiser, {'attr': {'class': 'btn btn-secondary w-full justify-center bg-white border border-gray-200 hover:bg-gray-50 text-gray-600'}}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleFilters() {
            const content = document.getElementById('filters-content');
            const chevron = document.getElementById('filters-chevron');
            
            if (content.style.maxHeight === '0px' || content.style.maxHeight === '0') {
                content.style.maxHeight = '1000px';
                content.style.opacity = '1';
                content.style.paddingTop = '1.5rem'; // Restore padding
                chevron.style.transform = 'rotate(180deg)';
            } else {
                content.style.maxHeight = '0';
                content.style.opacity = '0';
                content.style.paddingTop = '0';
                chevron.style.transform = 'rotate(0deg)';
            }
        }

        // Auto-open if filters are applied (basic check)
        document.addEventListener('DOMContentLoaded', function() {
            // You could add logic here to check if URL params exist to auto-open
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.toString()) {
               toggleFilters();
            }
        });
    </script>

    {# Tableau des sorties #}
    <div class="card fade-in" style="animation-delay: 0.1s">
        <div class="card-header">
            <div class="icon">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
            </div>
            <h2>Liste des sorties</h2>
            <span class="ml-auto badge badge-info">{{ sorties|length }} résultat(s)</span>
        </div>
        
        <div class="table-wrapper-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Nom de la sortie</th>
                        <th>Date de la sortie</th>
                        <th>Clôture</th>
                        <th>Inscrits</th>
                        <th>État</th>
                        <th>Inscrit</th>
                        <th>Organisateur</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for sortie in sorties %}
                    <tr>
                        <td>
                            <span class="font-medium text-gray-900">{{ sortie.nom ? sortie.nom : 'Pas de nom' }}</span>
                        </td>
                        <td>
                            <span class="text-gray-600">{{ sortie.dateHeureDebut ? sortie.dateHeureDebut|date('d/m/Y H:i') : 'Pas de date' }}</span>
                        </td>
                        <td>
                            <span class="text-gray-500">{{ sortie.dateLimiteInscription ? sortie.dateLimiteInscription|date('d/m/Y') : 'Pas de date' }}</span>
                        </td>
                        <td>
                            <span class="badge {{ sortie.participants|length >= sortie.nbInscriptionMax ? 'badge-danger' : 'badge-success' }}">
                                {{ sortie.participants|length }}/{{ sortie.nbInscriptionMax }}
                            </span>
                        </td>
                        <td>
                            {% set etatClass = {
                                'Créée': 'badge-secondary',
                                'Ouverte': 'badge-success',
                                'Clôturée': 'badge-warning',
                                'Activité en cours': 'badge-info',
                                'Activité terminée': 'badge-secondary',
                                'Activité archivée': 'badge-secondary',
                                'Annulée': 'badge-danger'
                            } %}
                            <span class="badge {{ etatClass[sortie.etat.libelle] | default('badge-secondary') }}">
                                {{ sortie.etat.libelle }}
                            </span>
                        </td>
                        <td class="text-center">
                            {% if app.user in sortie.participants %}
                                <span class="status-check yes">✓</span>
                            {% else %}
                                <span class="status-check no">−</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if sortie.organisateur %}
                                <a href="{{ path('app_participant_show', {'id': sortie.organisateur.id}) }}" class="text-indigo-600 hover:text-indigo-800 font-medium transition">
                                    {{ sortie.organisateur.prenom }} {{ sortie.organisateur.nom }}
                                </a>
                            {% else %}
                                <span class="text-gray-700">Inconnu</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                {% if is_granted('SORTIE_AFFICHER', sortie) %}
                                    <a href="{{ path('sortie_detailSortie', {"id" : sortie.id}) }}" class="action-link action-view">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                        Voir
                                    </a>
                                {% endif %}
                                {% if is_granted('SORTIE_INSCRIRE', sortie) %}
                                    <a href="{{ path('inscrit', {"id" : sortie.id}) }}" class="action-link action-success">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                        S'inscrire
                                    </a>
                                {% endif %}
                                {% if is_granted('SORTIE_DESISTER', sortie) %}
                                    <a href="{{ path('desister', {"id" : sortie.id}) }}" class="action-link action-delete">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        Désister
                                    </a>
                                {% endif %}
                                {% if is_granted('SORTIE_MODIFIER', sortie) %}
                                    <a href="#" class="action-link action-edit">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                        Modifier
                                    </a>
                                {% endif %}
                                {% if is_granted('SORTIE_PUBLIER', sortie) %}
                                    <a href="{{ path('sortie_publier', {"id" : sortie.id}) }}" class="action-link action-view">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        Publier
                                    </a>
                                {% endif %}
                                {% if is_granted('SORTIE_ANNULER', sortie) %}
                                    <a href="#" class="action-link action-delete">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                                        Annuler
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-8 text-gray-500">
                            <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Aucune sortie trouvée
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Bouton créer une sortie #}
    <div class="flex justify-center mt-6">
        <a href="{{ path('sortie_addSortie') }}" class="btn btn-success btn-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
            Créer une sortie
        </a>
    </div>

    {{ form_end(formSearchFilter) }}
{% endblock %}