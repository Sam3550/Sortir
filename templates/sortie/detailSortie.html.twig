{% extends 'base.html.twig' %}

{% block title %}Sortie - {{ sortie.nom }}{% endblock %}

{% block body %}
    <h1 class="page-title">🎉 <span class="page-title-gradient">{{ sortie.nom }}</span></h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        {# COLONNE PRINCIPALE (2/3) : Infos + Lieu #}
        <div class="lg:col-span-2 space-y-8">
            {# Informations de la sortie #}
            <div class="card fade-in">
                <div class="card-header">
                    <div class="icon">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h2>Informations</h2>
                </div>
                
                <div class="space-y-6">
                    <!-- Organisateur Profile -->
                    <div class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl shadow-sm">
                        <div class="relative">
                            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-pink-500 to-orange-400 flex items-center justify-center text-white font-bold text-xl shadow-md border-2 border-white">
                                {{ sortie.organisateur.prenom|first }}{{ sortie.organisateur.nom|first }}
                            </div>
                            <div class="absolute -bottom-1 -right-1 bg-green-500 w-5 h-5 rounded-full border-2 border-white" title="En ligne"></div>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-0.5">Organisé par</p>
                            <h3 class="font-bold text-gray-900 text-lg leading-tight">
                                {{ sortie.organisateur.prenom }} {{ sortie.organisateur.nom }}
                            </h3>
                            <a href="#" class="text-xs text-indigo-600 font-semibold hover:text-indigo-800 transition">
                                @{{ sortie.organisateur.prenom|lower }}{{ sortie.organisateur.nom|lower }}
                            </a>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                            <svg class="w-5 h-5 text-indigo-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                            <div>
                                <span class="text-xs font-medium text-gray-500 uppercase">Nom de la sortie</span>
                                <p class="font-semibold text-gray-900">{{ sortie.nom }}</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                            <svg class="w-5 h-5 text-indigo-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <div>
                                <span class="text-xs font-medium text-gray-500 uppercase">Date & heure</span>
                                <p class="font-semibold text-gray-900">{{ sortie.dateHeureDebut | date("d/m/Y à H:i") }}</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                            <svg class="w-5 h-5 text-orange-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <div>
                                <span class="text-xs font-medium text-gray-500 uppercase">Date limite d'inscription</span>
                                <p class="font-semibold text-gray-900">{{ sortie.dateLimiteInscription | date("d/m/Y") }}</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                                <svg class="w-5 h-5 text-green-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                <div>
                                    <span class="text-xs font-medium text-gray-500 uppercase">Places</span>
                                    <p class="font-semibold text-gray-900">{{ sortie.nbInscriptionMax }}</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <div>
                                    <span class="text-xs font-medium text-gray-500 uppercase">Durée</span>
                                    <p class="font-semibold text-gray-900">{{ sortie.duree }} min</p>
                                </div>
                            </div>
                        </div>

                        <div class="p-3 bg-indigo-50 rounded-lg border border-indigo-100">
                            <span class="text-xs font-medium text-indigo-600 uppercase">Description</span>
                            <p class="text-gray-700 mt-1">{{ sortie.infosSortie }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# Lieu de la sortie #}
            <div class="card fade-in" style="animation-delay: 0.1s">
                <div class="card-header">
                    <div class="icon">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <h2>Lieu</h2>
                </div>
                
                <div class="space-y-3 mb-4">
                    <div class="flex items-center gap-3">
                        <span class="badge badge-info">{{ sortie.lieu.ville.nom }}</span>
                        <span class="text-gray-400">•</span>
                        <span class="text-gray-600">{{ sortie.lieu.ville.codePostal }}</span>
                    </div>
                    <p class="font-semibold text-lg text-gray-900">{{ sortie.lieu.nom }}</p>
                    <p class="text-gray-600">{{ sortie.lieu.rue }}</p>
                    <div class="flex gap-4 text-sm text-gray-500">
                        <span>📍 Lat: {{ sortie.lieu.latitude }}</span>
                        <span>📍 Lng: {{ sortie.lieu.longitude }}</span>
                    </div>
                </div>

                {# Carte Leaflet #}
                <div id="map" style="height: 300px; border-radius: 12px; overflow: hidden;"></div>
            </div>
        </div>

        {# COLONNE LATERALE (1/3) : Participants + Actions #}
        <div class="lg:col-span-1 space-y-6">
            
            {# Liste des participants #}
            <div class="card fade-in" style="animation-delay: 0.2s">
                <div class="card-header justify-between">
                    <div class="flex items-center gap-3">
                        <div class="icon">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                            </svg>
                        </div>
                        <h2>Inscrits</h2>
                    </div>
                    
                    <span class="badge {{ sortie.participants|length >= sortie.nbInscriptionMax ? 'badge-danger' : 'badge-success' }}">
                        {{ sortie.participants|length }}/{{ sortie.nbInscriptionMax }}
                    </span>
                </div>

                <div class="overflow-y-auto max-h-[400px] pr-2 custom-scrollbar">
                    {% if sortie.participants|length > 0 %}
                        <div class="space-y-3">
                            {% for participant in sortie.participants %}
                                <div class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded-lg transition">
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 flex flex-shrink-0 items-center justify-center text-white font-bold text-xs">
                                        {{ participant.prenom|first }}{{ participant.nom|first }}
                                    </div>
                                    <div class="min-w-0">
                                        <p class="font-medium text-gray-900 text-sm truncate">{{ participant.prenom }} {{ participant.nom }}</p>
                                        <p class="text-xs text-gray-500 truncate">{{ participant.campus.nom }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-6 text-gray-500 text-sm">
                            <svg class="w-8 h-8 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            Aucun participant
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Boutons d'action (Sticky) #}
            <div class="card fade-in sticky top-6 bg-indigo-50 border-indigo-100" style="animation-delay: 0.3s">
                <h3 class="font-semibold text-lg text-gray-900 mb-4">Actions</h3>
                <div class="space-y-3">
                    {% if is_granted('SORTIE_INSCRIRE', sortie) %}
                        {% if app.user in sortie.participants %}
                             <div class="text-center p-3 bg-green-100 text-green-700 rounded-lg font-medium text-sm mb-2">
                                ✓ Vous êtes inscrit
                             </div>
                        {% endif %}
                        <a href="{{ path('inscrit', {"id" : sortie.id}) }}" class="btn btn-success w-full justify-center">
                            S'inscrire à la sortie
                        </a>
                    {% endif %}
                    
                    {% if is_granted('SORTIE_DESISTER', sortie) %}
                        <a href="{{ path('desister', {"id" : sortie.id}) }}" class="btn btn-danger w-full justify-center">
                            Se désister
                        </a>
                    {% endif %}
                    
                    {% if is_granted('SORTIE_MODIFIER', sortie) %}
                         <a href="#" class="btn btn-secondary w-full justify-center bg-white border border-gray-200">
                            Modifier la sortie
                        </a>
                    {% endif %}
                    
                    <a href="{{ path('sortie_list') }}" class="btn btn-secondary w-full justify-center bg-white">
                        Retour au catalogue
                    </a>
                </div>
            </div>

        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const lat = {{ sortie.lieu.latitude|default(48.8566) }};
            const lng = {{ sortie.lieu.longitude|default(2.3522) }};
            const lieuNom = "{{ sortie.lieu.nom|e('js') }}";
            const lieuRue = "{{ sortie.lieu.rue|e('js') }}";
            const villeNom = "{{ sortie.lieu.ville.nom|e('js') }}";

            const map = L.map('map').setView([lat, lng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            const marker = L.marker([lat, lng]).addTo(map);
            marker.bindPopup(`
                <div style="text-align: center; font-family: system-ui;">
                    <strong style="color: #4f46e5;">${lieuNom}</strong><br>
                    <span style="color: #6b7280;">${lieuRue}</span><br>
                    <em style="color: #9ca3af;">${villeNom}</em>
                </div>
            `).openPopup();
        });
    </script>
{% endblock %}
