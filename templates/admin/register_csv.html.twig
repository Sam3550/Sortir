{% extends 'base.html.twig' %}

{% block title %}Importation CSV{% endblock %}

{% block body %}
    <h1 class="page-title">📥 <span class="page-title-gradient">Importer des utilisateurs</span></h1>

    <div class="card max-w-xl mx-auto fade-in">
        <div class="card-header">
            <div class="icon">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            </div>
            <h2>Fichier CSV</h2>
        </div>

        {{ form_start(form, {'attr': {'class': 'p-6 space-y-6'}}) }}
            
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
                <h3 class="text-sm font-bold text-blue-800 mb-2">Instructions</h3>
                <ul class="list-disc list-inside text-sm text-blue-700 space-y-1">
                    <li>Le fichier doit être au format <strong>.csv</strong>.</li>
                    <li>La seule colonne obligatoire est : <code>mail</code>.</li>
                    <li>Séparez les valeurs par des virgules (,).</li>
                </ul>
            </div>

            <div>
                 {{ form_label(form.csv_file, 'Sélectionnez le fichier', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                 {{ form_widget(form.csv_file, {'attr': {'class': 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100'}}) }}
                 {{ form_errors(form.csv_file) }}
            </div>

            <div class="pt-6 border-t border-gray-100 flex justify-end gap-3">
                <a href="{{ path('app_admin_index') }}" class="btn btn-secondary">Annuler</a>
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                    Importer maintenant
                </button>
            </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
