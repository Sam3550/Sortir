{% extends 'base.html.twig' %}

{% block title %}Modifier la Ville{% endblock %}

{% block body %}
    <h1 class="page-title">✏️ <span class="page-title-gradient">Modifier la Ville</span></h1>

    <div class="card max-w-lg mx-auto fade-in">
        <div class="card-header">
            <div class="icon">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </div>
            <h2>{{ ville.nom }}</h2>
        </div>

        {{ form_start(form, {'attr': {'class': 'p-6 space-y-6'}}) }}
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                 <div>
                     {{ form_label(form.nom, 'Nom de la ville', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                     {{ form_widget(form.nom, {'attr': {'class': 'form-input w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                     {{ form_errors(form.nom) }}
                 </div>
                 <div>
                     {{ form_label(form.codePostal, 'Code Postal', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                     {{ form_widget(form.codePostal, {'attr': {'class': 'form-input w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                     {{ form_errors(form.codePostal) }}
                 </div>
            </div>

            <div class="pt-6 border-t border-gray-100 flex flex-col-reverse sm:flex-row justify-between items-center gap-4 mt-6">
                 {{ include('admin/ville/_delete_form.html.twig') }}
                 
                 <div class="flex gap-3 w-full sm:w-auto justify-end">
                    <a href="{{ path('app_ville_index') }}" class="btn btn-secondary">Annuler</a>
                    <button class="btn btn-primary">Enregistrer</button>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
